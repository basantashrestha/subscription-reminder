name: Docker Build & Trivy Scan

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch: {}

jobs:
  backend-unit-tests:
    runs-on: ubuntu-latest
    permissions:
      contents: read

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: '8.2'
          coverage: none

      - name: Install Composer dependencies
        working-directory: backend
        run: composer install --no-interaction --prefer-dist

      - name: Run PHPUnit
        working-directory: backend
        run: vendor/bin/phpunit --colors=always

  build-and-scan:
    needs: backend-unit-tests
    runs-on: ubuntu-latest
    permissions:
      contents: read

    strategy:
      fail-fast: false
      matrix:
        include:
          - service: backend
            context: ./backend
          - service: frontend
            context: ./frontend

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # Build the image and load it into the local docker daemon
      # (needed so Trivy and `docker save` can see it below).
      - name: Build ${{ matrix.service }} image
        uses: docker/build-push-action@v6
        with:
          context: ${{ matrix.context }}
          tags: subscription-reminder-${{ matrix.service }}:${{ github.sha }}
          push: false
          load: true

      # "Docker image artifact": export the built image as a .tar file
      # and upload it so it can be downloaded from the workflow run.
      - name: Save image as tar artifact
        run: |
          mkdir -p artifacts
          docker save subscription-reminder-${{ matrix.service }}:${{ github.sha }} \
            -o artifacts/${{ matrix.service }}-image.tar

      - name: Upload image artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ matrix.service }}-docker-image
          path: artifacts/${{ matrix.service }}-image.tar

      # Scan the image with Trivy. This step also prints a human-readable
      # table straight to the job log (visible under Actions -> this run).
      - name: Scan ${{ matrix.service }} image with Trivy
        # Pinned to v0.35.0 by full commit SHA (not a mutable tag) — this
        # release is the confirmed-safe one after the March 2026 trivy-action
        # supply-chain compromise. Don't switch back to a bare version tag.
        uses: aquasecurity/trivy-action@57a97c7e7821a5776cebc9bb87c984fa69cba8f1 # v0.35.0
        with:
          image-ref: subscription-reminder-${{ matrix.service }}:${{ github.sha }}
          format: table
          output: trivy-${{ matrix.service }}-report.txt
          severity: CRITICAL,HIGH,MEDIUM
          ignore-unfixed: true
          # Set to '1' instead if you want the workflow to fail when
          # CRITICAL/HIGH vulnerabilities are found.
          exit-code: '0'

      # Print the report to the console explicitly, and also add it to the
      # run's Summary tab so it's easy to read without opening raw logs.
      - name: Print Trivy report to console
        run: cat trivy-${{ matrix.service }}-report.txt

      - name: Add Trivy report to job summary
        if: always()
        run: |
          echo "## Trivy scan report — ${{ matrix.service }}" >> "$GITHUB_STEP_SUMMARY"
          echo '```' >> "$GITHUB_STEP_SUMMARY"
          cat trivy-${{ matrix.service }}-report.txt >> "$GITHUB_STEP_SUMMARY"
          echo '```' >> "$GITHUB_STEP_SUMMARY"

      - name: Upload Trivy report artifact
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: trivy-${{ matrix.service }}-report
          path: trivy-${{ matrix.service }}-report.txt
